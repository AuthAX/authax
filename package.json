{
  "name": "@repo/monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*/*"
  ],
  "scripts": {
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "bun run --filter '*' lint:check",
    "lint:fix": "bun run --filter '*' lint:fix",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run lint:check && bun run test:run && bun run typecheck",
    "outdated": "bun outdated --recursive",
    "update": "bun update --recursive",
    "update:latest": "bun update --latest --recursive",
    "clean:soft": "rm -rf node_modules packages/*/node_modules examples/*/*/{node_modules,.next,.tanstack,dist,tsconfig.tsbuildinfo} && bun install",
    "clean:hard": "rm -rf bun.lock && bun run clean:soft"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
